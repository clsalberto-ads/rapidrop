# Database
DATABASE_URL=postgresql+asyncpg://rapidrop:rapidrop_dev@localhost:5432/rapidrop
DATABASE_URL_SYNC=postgresql://rapidrop:rapidrop_dev@localhost:5432/rapidrop

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rapidrop
S3_SECRET_KEY=rapidrop_dev
S3_BUCKET=rapidrop-assets

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Asaas (pagamentos)
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox  # sandbox | production

# Sentry
SENTRY_DSN=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=rapidrop-api

# Domain
DOMAIN=rapidrop.com.br
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
