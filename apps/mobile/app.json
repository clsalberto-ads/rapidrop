{
  "expo": {
    "name": "RapiDrop",
    "slug": "rapidrop",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rapidrop",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rapidrop.app",
      "associatedDomains": ["applinks:rapidrop.com.br"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para encontrar lojas próximas.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Precisamos da sua localização para acompanhar suas entregas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "package": "com.rapidrop.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "https", "host": "rapidrop.com.br" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-notifications",
      "expo-secure-store",
      "expo-linking"
    ]
  }
}
